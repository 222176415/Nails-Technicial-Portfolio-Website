# ─────────────────────────────────────────────────────────────
# Shasha Nails — Environment Variables
# Copy this file to .env and fill in real values.
# NEVER commit .env to git — only commit .env.example
# ─────────────────────────────────────────────────────────────

# Owner WhatsApp number — digits ONLY, no +, no spaces, no dashes
# e.g. South Africa +27 69 125 5967 → "27691255967"
VITE_OWNER_PHONE=27691255967

# Salon GPS coordinates (used for Haversine distance calculation)
# Get from: https://www.latlong.net/
VITE_SALON_LAT=-26.0936
VITE_SALON_LNG=28.0064

# House call pricing
VITE_PER_KM_RATE=12.00        # Rands charged per kilometre
VITE_BASE_HOUSE_FEE=150.00    # Flat base fee for any house call

# Calendly booking URL (used for the "skip to Calendly" escape link)
VITE_CALENDLY_URL=https://calendly.com/nsukugold07
